{
  "expo": {
    "name": "BhukkadVerse",
    "slug": "bhukkad-verse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bhukkadverse",
    "userInterfaceStyle": "dark",
