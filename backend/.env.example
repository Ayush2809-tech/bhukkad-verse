# ========================================================
# BHUKKAD VERSE — Backend Environment Configuration Example
# ========================================================

# Core Settings
DEBUG=True
SECRET_KEY=bhukkadverse-insecure-dev-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to SQLite if DB_ENGINE is empty or sqlite3)
# To use PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bhukkadverse_db
# DB_USER=bhukkad_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
DB_ENGINE=sqlite3

# External Services (Placeholders for later phases)
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=rzp_secret_placeholder
# RESEND_API_KEY=re_placeholder
# DEFAULT_FROM_EMAIL=orders@bhukkadverse.local
